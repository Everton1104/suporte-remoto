# segredos e estado do servidor — NUNCA versionar
servidor/clientes.json
servidor/clientes/
servidor/sessoes/
servidor/.sessoes.json
servidor/.atualizar-espelho.log
suporte-2026*.sh

# binários espelhados em servidor/static (centenas de MB;
# servidor/atualizar-espelho.sh rebaixa tudo quando preciso)
servidor/static/*
!servidor/static/versoes.json

# artefatos gerados
servidor/__pycache__/
*.pyc
servidor/extensoes/*.vsix

# preferências locais de editor/agentes
.claude/settings.local.json

# prints de tela recebidos no chat do painel (dado de cliente, fora do git)
servidor/uploads/

# mais segredos/estado do servidor (2FA, hosts conhecidos, WinPE)
servidor/2fa.json
servidor/known_hosts
servidor/wpe-token.txt
servidor/wpe-cmd.txt
servidor/wpe-beacons.log
